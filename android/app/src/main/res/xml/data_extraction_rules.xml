<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: hiçbir dosya buluta yedeklenmez ve cihazdan cihaza
     aktarılmaz. Şifreli Hive kutuları anahtarsız (Keystore taşınmaz)
     yeni cihazda açılamaz; taşımak yalnız bozuk veri ve "veriler
     sıfırlandı" ekranı üretir. Taşıma yolu uygulama içi şifreli yedektir. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
