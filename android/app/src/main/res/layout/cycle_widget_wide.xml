<?xml version="1.0" encoding="utf-8"?>
<!-- 4x2 geniş widget: solda mini faz ring'i, sağda gün + üç tahmin
     satırı (sonraki regl / ovülasyon / verimli pencere). Daha fazla
     alan verene daha fazla değer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/cycle_widget_bg">

    <ImageView
        android:id="@+id/widget_ring"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginEnd="14dp"
        android:visibility="gone"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_line1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#2D2D3A" />

        <TextView
            android:id="@+id/widget_line2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#6E6E7A" />

        <LinearLayout
            android:id="@+id/widget_row1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_row1_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="#6E6E7A" />
            <TextView
                android:id="@+id/widget_row1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2D2D3A" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_row2_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="#6E6E7A" />
            <TextView
                android:id="@+id/widget_row2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2D2D3A" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_row3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/widget_row3_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textColor="#6E6E7A" />
            <TextView
                android:id="@+id/widget_row3_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#2D2D3A" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
